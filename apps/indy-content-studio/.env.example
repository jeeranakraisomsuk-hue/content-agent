# Production variables: copy names into the deployment secret manager; never commit real values.
# Setup instructions: ../../docs/line-oa-production-runbook.md

# Neon Console -> Connect. Use the production branch only in the deployment environment.
DATABASE_URL=

# LINE Developers Console -> the Messaging API channel linked to the intended OA.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Vercel Blob private store, connected in Vercel Storage. OIDC supplies credentials on Vercel.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Legacy Google Workspace integration only; new media uploads use Vercel Blob.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Public HTTPS origin only; no path or trailing slash.
APP_PUBLIC_BASE_URL=

# Make webhook receives Finalized per-platform publication payloads and must callback before/after publication.
MAKE_PUBLICATION_WEBHOOK_URL=
MAKE_API_TOKEN=

# Generate distinct random values; see the runbook.
INDY_MEDIA_SIGNING_SECRET=
INDY_MEDIA_UPLOAD_TOKEN=
LINE_RECIPIENT_ENCRYPTION_KEY=
AUTH_SECRET=

# Scrypt hash generated by scripts/hash-admin-password.mjs; never the clear-text password.
INDY_ADMIN_PASSWORD_HASH=

# Local test-only settings; never add these to production deployment settings.
# Use a fresh, disposable Neon test branch only.
LINE_OA_TEST_DATABASE_URL=
LINE_OA_RUN_DATABASE_FLOW=
